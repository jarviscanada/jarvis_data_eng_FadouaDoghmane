      "displayName": "Gold_Stock_Data",
      "queryLines": [
        "SELECT *\r\n",
        "FROM default.gold_stock_data\r\n",
        "ORDER BY date;"
      ]
    },
    {
      "name": "309afe72",
      "displayName": "Stock Price Trend with Moving Averages",
      "queryLines": [
