  "datasets": [
    {
      "name": "62fd4ddd",
      "displayName": "gold_stock_summary",
      "queryLines": [
        "SELECT * FROM gold_stock_summary"
      ],
      "catalog": "hive_metastore",
      "schema": "dlt_demo"
    },
    {
      "name": "f68abe68",
      "displayName": "KPI Cards (Dynamic per symbol)",
      "queryLines": [
        "-- Latest values for all symbols (dashboard can filter by symbol)\r\n",
        "SELECT\r\n",
        "    symbol,\r\n",
        "    FIRST_VALUE(close) OVER (PARTITION BY symbol ORDER BY date DESC) AS current_price,\r\n",
        "    FIRST_VALUE(ma_7_close) OVER (PARTITION BY symbol ORDER BY date DESC) AS ma_7_day,\r\n",
        "    FIRST_VALUE(ma_30_close) OVER (PARTITION BY symbol ORDER BY date DESC) AS ma_30_day,\r\n",
        "    FIRST_VALUE(daily_return_pct) OVER (PARTITION BY symbol ORDER BY date DESC) AS daily_return_pct,\r\n",
        "    FIRST_VALUE(total_monthly_volume) OVER (PARTITION BY symbol ORDER BY date DESC) AS total_monthly_volume\r\n",
        "FROM gold_stock_summary"
      ],
      "catalog": "hive_metastore",
      "schema": "dlt_demo"
    },
    {
      "name": "7cd0ce86",
      "displayName": "Daily Closing Price Trend (All symbols)",
      "queryLines": [
        "SELECT\r\n",
        "    symbol,\r\n",
        "    date,\r\n",
        "    close,\r\n",
        "    ma_7_close,\r\n",
        "    ma_30_close\r\n",
        "FROM gold_stock_summary\r\n",
        "ORDER BY symbol, date ASC;"
      ],
      "catalog": "hive_metastore",
      "schema": "dlt_demo"
    },
    {
      "name": "97611284",
      "displayName": "Daily Return % Trend (All symbols)",
      "queryLines": [
        "SELECT\r\n",
        "    symbol,\r\n",
        "    date,\r\n",
        "    daily_return_pct\r\n",
        "FROM gold_stock_summary\r\n",
        "ORDER BY symbol, date ASC;"
      ],
      "catalog": "hive_metastore",
      "schema": "dlt_demo"
    },
    {
      "name": "6e720ae2",
      "displayName": "Daily Volume (All symbols)",
      "queryLines": [
        "SELECT\r\n",
        "    symbol,\r\n",
        "    date,\r\n",
        "    volume\r\n",
        "FROM gold_stock_summary\r\n",
        "ORDER BY symbol, date ASC;"
      ],
      "catalog": "hive_metastore",
      "schema": "dlt_demo"
    },
    {
      "name": "a4cafd71",
      "displayName": "Monthly Summary Table (All symbols)",
      "queryLines": [
        "SELECT\r\n",
        "    symbol,\r\n",
        "    year,\r\n",
        "    month,\r\n",
        "    avg_monthly_close,\r\n",
        "    max_monthly_high,\r\n",
        "    min_monthly_low,\r\n",
        "    avg_monthly_return_pct,\r\n",
        "    total_monthly_volume\r\n",
        "FROM gold_stock_summary\r\n",
        "ORDER BY symbol, year, month;"
      ],
      "catalog": "hive_metastore",
      "schema": "dlt_demo"
    }
  ],
