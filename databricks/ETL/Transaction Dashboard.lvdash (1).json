    {
      "name": "033cfd81",
      "displayName": "top_10_fraud_user_metrics",
      "queryLines": [
        "SELECT client_id, SUM(fraud_transactions) AS total_fraud\r\n",
        "FROM gold.fraud_user_metrics\r\n",
        "GROUP BY client_id\r\n",
        "ORDER BY total_fraud DESC\r\n",
        "LIMIT 10"
      ]
    }
