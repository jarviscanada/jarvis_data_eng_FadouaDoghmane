      "name": "3884098c",
      "displayName": "Transaction Dashboard",
      "layout": [
        {
          "widget": {
            "name": "fraud-rate-trend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "d817f5f2",
                  "fields": [
                    {
                      "name": "monthly(date)",
                      "expression": "DATE_TRUNC(\"MONTH\", `date`)"
                    },
                    {
                      "name": "sum(fraud_rate)",
                      "expression": "SUM(`fraud_rate`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "frame": {
                "showTitle": true,
                "title": "Fraud Rate Trend"
              },
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "monthly(date)",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "sum(fraud_rate)",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              }
            }
          },
          "position": {
